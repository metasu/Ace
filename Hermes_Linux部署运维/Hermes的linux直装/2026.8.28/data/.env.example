# ===== Hermes Gateway =====
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=50001
# 部署时自动生成随机值；此处仅占位
API_SERVER_KEY=RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR

# ===== 对话渠道密钥（config.yaml key_env 引用）=====
# 请替换为你在各渠道实际申请的 API Key
HERMES_ATLASCLOUD_KEY=apikey-RRRRRRRRRRRRRRRRRRRRRRRRRR
HERMES_KUAIPAO_GPT_KEY=sk-RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR
HERMES_XIAOYI_KEY=sk-RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR

# ===== MCP 服务配置（hermesctl.sh / hermes-deploy.sh 读取，不写入 config.yaml）=====
XIAOYI_GROK_IMAGE_KEY=sk-RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR
XIAOYI_GROK_IMAGE_API_URL=https://xiaoyiapi.xyz/v1
MCP_ATLASCLOUD_KEY=apikey-RRRRRRRRRRRRRRRRRRRRRRRRRR
MCP_ATLASCLOUD_API_URL=https://api.atlascloud.ai

# GitHub MCP（npx @modelcontextprotocol/server-github）
# 前往 https://github.com/settings/tokens 生成 Personal Access Token（classic），至少勾选 repo / read:org / read:user / gist
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_RRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRRR

# ===== 反屏蔽 User-Agent =====
HERMES_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# ===== 调试与行为 =====
WEB_TOOLS_DEBUG=false
HERMES_HUMAN_DELAY_MODE=off

# ===== WebUI 发现路径 =====
HERMES_WEBUI_AGENT_DIR=/opt/hermes/hermes-agent
HERMES_WEBUI_STATE_DIR=/opt/hermes/data/webui

# ===== WebUI 登录密码（公网反代必开）=====
# 上线后请立即修改并 systemctl restart hermes-webui
HERMES_WEBUI_PASSWORD=RRRRRRRRRR
