# Hermes Windows 便携部署 — 环境变量模板
# 复制为 .env 并填入真实 API Key。
# start.bat 中的环境变量优先级高于此文件。

API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=50001
API_SERVER_KEY=local-dev-key-not-for-production

# ===== 对话渠道密钥（config.yaml 的 key_env 引用）=====
HERMES_ATLASCLOUD_GROK_43_KEY=your-atlascloud-grok-43-key
HERMES_ATLASCLOUD_GROK_45_KEY=your-atlascloud-grok-45-key
HERMES_XIAOYI_KEY=your-xiaoyi-key

# ===== MCP 服务密钥（inject_mcp_config.py 读取）=====
XIAOYI_GROK_IMAGE_KEY=your-xiaoyi-image-key
MCP_ATLASCLOUD_KEY=your-atlascloud-mcp-key
MCP_ATLASCLOUD_API_URL=https://api.atlascloud.ai

# ===== GitHub MCP =====
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-pat

# ===== Provider 行为调优 =====
# Xiaoyi's SSE path is unreliable; use completed Chat Completions responses.
HERMES_NON_STREAMING_PROVIDERS=Xiaoyi-gpt-5.6-sol
# Compact only Xiaoyi requests; fallback providers keep the normal Hermes payload.
HERMES_COMPACT_REQUEST_PROVIDERS=Xiaoyi-gpt-5.6-sol
# Xiaoyi GPT-5.6 expects max_tokens on Chat Completions.
HERMES_FORCE_MAX_TOKENS_PROVIDERS=Xiaoyi-gpt-5.6-sol
# Use the SDK default transport; Xiaoyi is incompatible with Hermes' custom
# keepalive httpx client. Other providers keep the custom transport.
HERMES_SKIP_CUSTOM_HTTP_PROVIDERS=Xiaoyi-gpt-5.6-sol
# Bound each upstream request so provider fallback cannot be held indefinitely.
HERMES_API_TIMEOUT=60
